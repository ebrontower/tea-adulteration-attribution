 "nls_ladder": [
  "abs0.02",
  "abs0.05",
  "abs0.1",
  "rel0.1",
  "rel0.2",
  "rel0.35"
 ],
 "nls_row": "ORACLE: best exact-set over the whole ladder, threshold read off the test composites - an upper bound, not a claim",
 "nls_cal_row": "quotable NLS arm: dictionary from fit singles, relative cut from [0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.45] chosen as the smallest whose singleton-support accuracy on calibration singles is >= 0.9",
 "torch_device": "torch unavailable - cnn arms skipped",
 "decision_rules": {
  "A1": "prior-free detector within 0.02 AUROC of the gate => gate is not the contribution; justify by joint refuse+cover behaviour",
  "B1": "exact-set > 0.10 on held-out composites for any model/rep => rewrite 'not an artefact of one model family' as 'one linear model family'",
  "B2": "LDA(svd) balanced accuracy must not move between raw and white (invertible linear map); > 0.02 means the feature map is broken and Part B is void. Penalised learners are scale-sensitive and standardised in both arms, so their raw-vs-white gap is a result, not a bug signal",
  "B3": "'prior helps across model classes' requires a gain averaged over the non-invariant classes on tea AND the same direction on cinnamon",
  "C1": "if a self-supervised representation reaches exact-set > 0.10 on held-out composites for any model class, Section 3.10's 'the representation is not the bottleneck' is confined to discrimination and may not be quoted for attribution; if SSL matches the analytic representations on T1 but stays at or below them on T2, Sections 3.10 and 3.3 collapse into one statement - learned representations buy no attribution either"
 },
